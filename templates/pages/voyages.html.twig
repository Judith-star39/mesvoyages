{% extends "basefront.html.twig" %}

{% block body %}
    <table class="table table-striped">
        <thead>
            <tr>
                <th class="text-left align-top" scope="col">Ville
                    <a href="{{ path('voyages.sort', {champ: 'ville', ordre: 'ASC'}) }}" class="btn btn-primary btn-sm avtive" role="button" aria-pressed="true"><</a>
                    <a href="{{ path('voyages.sort', {champ: 'ville', ordre: 'DESC'}) }}" class="btn btn-primary btn-sm avtive" role="button" aria-pressed="true">></a>
                    <form class="mt-1" method="POST" action="{{ path('voyages.findallequal', {champ: 'ville'}) }}">
                        <div class="mb-2">
                            <input type="text" class="form-control form-control-sm" name="recherche">
                        </div>
                        <button type="submit" class="btn btn-primary mb-2 btn-sm">filtrer</button>
                    </form>
                </th>
                <th class="text-left align-top" scope="col">Pays
                    <a href="{{ path('voyages.sort', {champ: 'pays', ordre: 'ASC'}) }}" class="btn btn-primary btn-sm avtive" role="button" aria-pressed="true"><</a>
                    <a href="{{ path('voyages.sort', {champ: 'pays', ordre: 'DESC'}) }}" class="btn btn-primary btn-sm avtive" role="button" aria-pressed="true">></a>
                    <form class="mt-1" method="POST" action="{{ path('voyages.findallequal', {champ: 'pays'}) }}">
                        <div class="mb-2">
                            <input type="text" class="form-control form-control-sm" name="recherche">
                        </div>
                        <button type="submit" class="btn btn-primary mb-2 btn-sm">filtrer</button>
                    </form>
                </th>
                <th class="text-left align-top" scope="col">Note</th>
                <th class="text-center align-top" scope="col">Date</th>
            </tr>
        </thead>
        <tbody>
            {% for visite in visites %}
                <tr>
                    <td>
                        <h5 class="text-primary">
                            <a href="#">{{ visite.ville }}</a>
                        </h5>
                    </td>
                    <td>
                        {{ visite.pays }}
                    </td>
                    <td class="text-end">
                       <strong>
                            {% if visite.note < 10 %}
                                <div class="text-danger">
                                {{ visite.note }}/20
                                </div>
                                {% else %}
                                <div class="text-success">
                                {{ visite.note }}/20
                                </div>
                            {% endif %}
                        </strong>
                    </td>
                    <td class="text-center">
                        {{ visite.datecreationstring }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}